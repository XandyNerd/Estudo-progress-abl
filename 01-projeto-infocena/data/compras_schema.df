ADD TABLE "PedidoCompra"
  AREA "Schema Area"
  DUMP-NAME "pedidocompra"

ADD FIELD "Id_Pedido" OF "PedidoCompra" AS integer
  FORMAT ">>>>>>>9"
  INITIAL "0"
  LABEL "Num. Pedido"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "Id_Fornecedor" OF "PedidoCompra" AS integer
  FORMAT ">>>>>>>9"
  INITIAL "0"
  LABEL "Codigo Fornecedor"
  POSITION 3
  MAX-WIDTH 4
  ORDER 20

ADD FIELD "Data_Pedido" OF "PedidoCompra" AS date
  FORMAT "99/99/9999"
  INITIAL "TODAY"
  LABEL "Data do Pedido"
  POSITION 4
  MAX-WIDTH 4
  ORDER 30

ADD FIELD "Status_Pedido" OF "PedidoCompra" AS character
  FORMAT "x(20)"
  INITIAL "ABERTO"
  LABEL "Status"
  POSITION 5
  MAX-WIDTH 40
  ORDER 40

ADD FIELD "Condicao_Pagto" OF "PedidoCompra" AS character
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Condicao Pagto"
  POSITION 6
  MAX-WIDTH 80
  ORDER 50

ADD FIELD "Comprador" OF "PedidoCompra" AS character
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Comprador"
  POSITION 7
  MAX-WIDTH 80
  ORDER 60

ADD FIELD "Total_Pedido" OF "PedidoCompra" AS decimal
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Total Pedido"
  POSITION 8
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 70

ADD INDEX "idx_IdPedido" ON "PedidoCompra"
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "Id_Pedido" ASCENDING

ADD INDEX "idx_FornePedido" ON "PedidoCompra"
  AREA "Schema Area"
  INDEX-FIELD "Id_Fornecedor" ASCENDING

ADD TABLE "ItemPedidoCompra"
  AREA "Schema Area"
  DUMP-NAME "itempedidocompra"

ADD FIELD "Id_Pedido" OF "ItemPedidoCompra" AS integer
  FORMAT ">>>>>>>9"
  INITIAL "0"
  LABEL "Num. Pedido"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "Sequencia" OF "ItemPedidoCompra" AS integer
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Item"
  POSITION 3
  MAX-WIDTH 2
  ORDER 20

ADD FIELD "Id_Produto" OF "ItemPedidoCompra" AS integer
  FORMAT ">>>>>>>9"
  INITIAL "0"
  LABEL "Cod. Produto"
  POSITION 4
  MAX-WIDTH 4
  ORDER 30

ADD FIELD "Quantidade" OF "ItemPedidoCompra" AS decimal
  FORMAT "->>>,>>9.99"
  INITIAL "0"
  LABEL "Qtd. Pedida"
  POSITION 5
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 40

ADD FIELD "Preco_Unit" OF "ItemPedidoCompra" AS decimal
  FORMAT "->>>,>>9.99"
  INITIAL "0"
  LABEL "Preco Unit."
  POSITION 6
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 50

ADD FIELD "Total_Item" OF "ItemPedidoCompra" AS decimal
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Total Item"
  POSITION 7
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 60

ADD INDEX "idx_PedidoItem" ON "ItemPedidoCompra"
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "Id_Pedido" ASCENDING
  INDEX-FIELD "Sequencia" ASCENDING

.
PSC
cpstream=1252
.
