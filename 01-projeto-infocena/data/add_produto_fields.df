ADD FIELD "Marca" OF "Produto" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Marca"
  POSITION 10
  MAX-WIDTH 80
  ORDER 90

ADD FIELD "Estoque_Minimo" OF "Produto" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL 0
  LABEL "Estoque Min"
  POSITION 11
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 100

ADD FIELD "Ativo" OF "Produto" AS logical 
  FORMAT "Ativo/Inativo"
  INITIAL yes
  LABEL "Ativo"
  POSITION 12
  MAX-WIDTH 1
  ORDER 110
.
PSC
cpstream=1252
