ADD TABLE "Fornecedor"
  AREA "Schema Area"
  DUMP-NAME "fornecedor"

ADD FIELD "Id_Fornecedor" OF "Fornecedor" AS integer
  FORMAT ">>>>>>>9"
  INITIAL "0"
  LABEL "Codigo"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "Razao_Social" OF "Fornecedor" AS character
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Razao Social"
  POSITION 3
  MAX-WIDTH 120
  ORDER 20

ADD FIELD "Nome_Fantasia" OF "Fornecedor" AS character
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Nome Fantasia"
  POSITION 4
  MAX-WIDTH 80
  ORDER 30

ADD FIELD "CNPJ" OF "Fornecedor" AS character
  FORMAT "x(20)"
  INITIAL ""
  LABEL "CNPJ"
  POSITION 5
  MAX-WIDTH 40
  ORDER 40

ADD FIELD "Email" OF "Fornecedor" AS character
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Email"
  POSITION 6
  MAX-WIDTH 120
  ORDER 50

ADD FIELD "Telefone" OF "Fornecedor" AS character
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Telefone"
  POSITION 7
  MAX-WIDTH 40
  ORDER 60

ADD FIELD "Endereco" OF "Fornecedor" AS character
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Endereco"
  POSITION 8
  MAX-WIDTH 120
  ORDER 70

ADD FIELD "Cidade" OF "Fornecedor" AS character
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Cidade"
  POSITION 9
  MAX-WIDTH 60
  ORDER 80

ADD FIELD "Estado" OF "Fornecedor" AS character
  FORMAT "x(2)"
  INITIAL ""
  LABEL "UF"
  POSITION 10
  MAX-WIDTH 4
  ORDER 90

ADD FIELD "CEP" OF "Fornecedor" AS character
  FORMAT "x(10)"
  INITIAL ""
  LABEL "CEP"
  POSITION 11
  MAX-WIDTH 20
  ORDER 100

ADD INDEX "idx_IdFornecedor" ON "Fornecedor"
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "Id_Fornecedor" ASCENDING

ADD INDEX "idx_CNPJ_Forne" ON "Fornecedor"
  AREA "Schema Area"
  UNIQUE
  INDEX-FIELD "CNPJ" ASCENDING

.
