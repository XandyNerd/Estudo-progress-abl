UPDATE TABLE "Produto"
  TABLE-TRIGGER "REPLICATION-WRITE" NO-OVERRIDE PROCEDURE ""

ADD FIELD "Marca" OF "Produto" AS character 
  FORMAT "X(20)"
  INITIAL ""
  POSITION 10
  MAX-WIDTH 40
  ORDER 90

ADD FIELD "Estoque_Minimo" OF "Produto" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL "0"
  POSITION 11
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 100

ADD FIELD "Ativo" OF "Produto" AS logical 
  FORMAT "Sim/Nao"
  INITIAL "yes"
  POSITION 12
  MAX-WIDTH 1
  ORDER 110

ADD FIELD "URL_Imagem" OF "Produto" AS character 
  FORMAT "X(256)"
  INITIAL ""
  POSITION 13
  MAX-WIDTH 512
  ORDER 120

ADD FIELD "Foto_Blob" OF "Produto" AS blob 
  FORMAT "X(8)"
  INITIAL ?
  POSITION 14
  LOB-AREA "Schema Area"
  LOB-SIZE 100M
  ORDER 130

.
PSC
cpstream=1252
.
0000001850
