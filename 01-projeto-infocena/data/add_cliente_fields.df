ADD FIELD "Email" OF "Cliente" AS character 
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Email"
  POSITION 10
  MAX-WIDTH 120
  ORDER 90

ADD FIELD "Telefone" OF "Cliente" AS character 
  FORMAT "(99) 9 9999-9999"
  INITIAL ""
  LABEL "Telefone"
  POSITION 11
  MAX-WIDTH 40
  ORDER 100

ADD FIELD "CEP" OF "Cliente" AS character 
  FORMAT "99999-999"
  INITIAL ""
  LABEL "CEP"
  POSITION 12
  MAX-WIDTH 20
  ORDER 110

ADD FIELD "Numero" OF "Cliente" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Numero"
  POSITION 13
  MAX-WIDTH 20
  ORDER 120

ADD FIELD "Complemento" OF "Cliente" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Complemento"
  POSITION 14
  MAX-WIDTH 80
  ORDER 130

ADD FIELD "Bairro" OF "Cliente" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Bairro"
  POSITION 15
  MAX-WIDTH 80
  ORDER 140

ADD FIELD "PontoReferencia" OF "Cliente" AS character 
  FORMAT "x(100)"
  INITIAL ""
  LABEL "Ponto de Referencia"
  POSITION 16
  MAX-WIDTH 200
  ORDER 150
